#archetype StaticArray {
    #deduce T #argument 0
    #expect_all #all_arguments #type_of #type_of T
    #set count #argument_count
    #exposed content #byte #times #size_of T count
    #operator #call {
        #if #greater #argument 0 count {
            #return #null
        }
        #return #load content #argument 0
    }    
} #type T