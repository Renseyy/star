#!/bin/env/star
#memory_operator % 10 .unary_before {
    #set_flag #this .by_field
}

#value_operator ! 10 .unary_before

Boolean :: Type {
    true: #This : #symbol true
    false: #This : #symbol false
    value :: true | false
    #operator ! {
        #if #is_equal value true {
            #return false
        }
        #return true
    }
}

#define true Boolean.true
#define false Boolean.false


a = false
b = !a